	volume = {11},
	copyright = {https://doi.org/10.15223/policy-029},
	issn = {1944-8244, 1944-8252},
	url = {https://pubs.acs.org/doi/10.1021/acsami.8b22678},
	doi = {10.1021/acsami.8b22678},
	abstract = {Rational design of multifunctional and smart drug-delivered nanoplatforms is a promising strategy to achieve simultaneous diagnosis, real-time monitoring, and therapy of cancers. Herein, highly uniform and stable selenium nanoparticles with epidermal growth factor receptor (EGFR) targeting and tumor microenvironment-responsive ability (Se-5Fu-Gd-P(Cet/YI-12)) were designed and synthesized by using EGFR as the targeting molecule, gadolinium chelate as the magnetic resonance imaging contrast agent, 5-ﬂuorouracil (5Fu) and cetuximab as drug payloads, polyamidoamine (PAMAM) and 3,3′-dithiobis (sulfosuccinimidyl propionate) as the response agents of intratumoral glutathione, and pH for the treatment and diagnosis of nasopharyngeal carcinoma (NPC). This Se nanoplatform showed excellent magnetic resonance imaging capability and has the potential for its clinical application as a diagnostic agent for tumor tissue specimens. Additionally, in vitro cellular experiments showed that by means of introducing clinical targeted drugs and peptides not only validly increased the intracellular uptake of the Se nanoplatform in NPC cells but also enhanced its penetration ability toward CNE tumor spheroids, resulting in simultaneous inhibition of CNE cell growth, invasion, and migration. In addition, the sequentially triggered bioresponsive property of the nanoplatform in a tumor microenvironment eﬀectively improved the targeting delivery and anticancer eﬃciency of payloads. Overall, this study not only provides a strategy for facile synthesis of highly uniform and stable nanomedicines and tailing of the bioresponsive property but also sheds light on its application in targeting theranosis of NPC.},
	language = {en},
	number = {12},
	urldate = {2026-05-19},
	journal = {ACS Applied Materials \& Interfaces},
	author = {Huang, Jing and Huang, Wei and Zhang, Zehang and Lin, Xueran and Lin, Hao and Peng, Lijiao and Chen, Tianfeng},
	month = mar,
	year = {2019},
	pages = {11177--11193},
	file = {PDF:C\:\\Users\\boochi\\Zotero\\storage\\2XYTXB6E\\Huang 等 - 2019 - Highly Uniform Synthesis of Selenium Nanoparticles with EGFR Targeting and Tumor Microenvironment-Re.pdf:application/pdf},
}

