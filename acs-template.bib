	pages = {7106--7116},
	file = {PDF:C\:\\Users\\boochi\\Zotero\\storage\\GC3F4F6Q\\Huang 等 - 2013 - Selective cellular uptake and induction of apoptosis of cancer-targeted selenium nanoparticles.pdf:application/pdf},
}

