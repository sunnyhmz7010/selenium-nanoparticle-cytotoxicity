	title = {Facile {Fabrication} of {Near}‐{Infrared}‐{Responsive} and {Chitosan}‐{Functionalized} {Cu}$_{\textrm{2}}$ {Se} {Nanoparticles} for {Cancer} {Photothermal} {Therapy}},
