	file = {PDF:C\:\\Users\\boochi\\Zotero\\storage\\5NE3G6JB\\Huang 等 - 2020 - Chirality‐Driven Transportation and Oxidation Prevention by Chiral Selenium Nanoparticles.pdf:application/pdf},
}

@article{yang_lentinan-functionalized_2020,
	title = {Lentinan-functionalized selenium nanosystems with high permeability infiltrate solid tumors by enhancing transcellular transport},
